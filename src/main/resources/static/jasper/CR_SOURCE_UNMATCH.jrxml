	<queryString>
		<![CDATA[select A.* , TO_CHAR(TRXN_DATE, 'DD-MM-YY') as tran_date,
TO_CHAR(POSTING_DATE, 'DD-MM-YY') as post_date
from BRECON_CRFILE_SOURCE_TABLE A
WHERE DEL_FLG ='N' 
AND RECON_FLG ='N' 
AND TRUNC(recon_process_date) =  $P{SYS_DATE}]]>
	</queryString>
