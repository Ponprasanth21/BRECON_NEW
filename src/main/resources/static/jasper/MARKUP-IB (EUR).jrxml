	<queryString>
		<![CDATA[SELECT
    L1_EUR_EUR, 
	L2_EUR_EUR, 
	L1_EUR_MUREQUIV, 
	R1_EUR_EUR, 
	R2_EUR_EUR, 
	R1_EUR_USD, 
	R1_EUR_MUREQUIV, 
    POSTING_DATE,
    RECON_DATE
FROM
    BRECON_DEBIT_MARKUP_IB
WHERE
    RECON_TYPE = 'EUR'
AND  to_char(RECON_DATE,'DD-MM-YYYY')  = $P{REPORT_DATE}
    AND MARKUP_TYPE = 'IB']]>
	</queryString>
