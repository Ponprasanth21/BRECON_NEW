	<queryString>
		<![CDATA[SELECT
    L1_GBP_GBP, 
	L2_GBP_GBP, 
	L1_GBP_MUREQUIV, 
	R1_GBP_GBP, 
	R2_GBP_GBP, 
	R1_GBP_USD, 
	R1_GBP_MUREQUIV,  
    POSTING_DATE,
    RECON_DATE
FROM
    BRECON_DEBIT_MARKUP_IB
WHERE
