	<queryString>
		<![CDATA[SELECT
    L1_EUR1_EUR, 
	L1_EUR1_MUR, 
	R1_EUR1_MUREQUIV,  
    POSTING_DATE,
    RECON_DATE
FROM
    BRECON_DEBIT_MARKUP_IB
