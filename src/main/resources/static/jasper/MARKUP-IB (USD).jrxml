	<parameter name="REPORT_DATE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    L1_USD_USD, 
	R1_USD_USD,  
    POSTING_DATE,
    RECON_DATE
FROM
    BRECON_DEBIT_MARKUP_IB
WHERE
    RECON_TYPE = 'USD'
    AND  to_char(RECON_DATE,'DD-MM-YYYY')  = $P{REPORT_DATE}
    AND MARKUP_TYPE = 'IB']]>
	</queryString>
