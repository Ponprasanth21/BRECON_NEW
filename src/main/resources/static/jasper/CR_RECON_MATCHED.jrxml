	<queryString>
		<![CDATA[SELECT A.* , TO_CHAR(S_TRXN_DATE, 'DD-MM-YY') as tran_date,
TO_CHAR(S_POSTING_DATE, 'DD-MM-YY') as post_date
FROM BRECON_CRMAIN_TABLE  A
WHERE DEL_FLG ='N' 
AND TRUNC(S_RECON_PROCESS_DATE) =  $P{SYS_DATE}]]>
	</queryString>
