	<queryString>
		<![CDATA[SELECT
    L1_CAD_CAD, 
	L2_CAD_CAD, 
	L1_CAD_MUR, 
	R1_CAD_CAD, 
	R2_CAD_CAD, 
	R1_CAD_USD, 
	R1_CAD_MUREQUIV,
