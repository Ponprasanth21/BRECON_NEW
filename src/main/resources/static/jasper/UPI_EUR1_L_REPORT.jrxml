	<queryString>
		<![CDATA[SELECT    
    L1_EUR1L_EUR,
    L1_EUR1L_MUR,
    R1_EUR1L_MUREQUIV,
    POSTING_DATE,
    RECON_DATE 
FROM 
   BRECON_UPI_MARKUP
WHERE  RECON_DATE = TO_DATE($P{DATE}, 'DD-MM-YYYY')
AND RECON_TYPE ='EUR1 L']]>
	</queryString>
